---
const resources = [
  {
    label: 'Join Server',
    url: 'fivem://connect/server.arizonastateroleplay.com'
  },
  {
    label: 'CAD',
    url: 'https://cad.arizonastateroleplay.com'
  },
  {
    label: 'Dispatch',
    url: 'http://dispatch.arizonastateroleplay.com:7777'
  }
]
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Arizona State Roleplay</title>
    <style>
      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
      }

      body {
        margin: 0;
        min-height: 100%;
        font-family: Arial, sans-serif;
        background: #0f172a;
        color: white;
        overflow-x: hidden;
      }

      .hero {
        min-height: 100svh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: clamp(1rem, 4vw, 4rem);
        background: linear-gradient(rgba(0,0,0,.72), rgba(0,0,0,.72)),
          url('https://dedisystems.b-cdn.net/azsrp/3D-Mockup.jpg');
        background-size: cover;
        background-position: center;
      }

      .container {
        width: min(100%, 960px);
        margin: 0 auto;
        padding: clamp(1rem, 3vw, 2rem);
      }

      .logo {
        width: clamp(72px, 14vw, 130px);
        height: clamp(72px, 14vw, 130px);
        border-radius: 50%;
        margin-bottom: clamp(.75rem, 2vw, 1.25rem);
        object-fit: cover;
      }

      h1 {
        font-size: clamp(2.1rem, 8vw, 5rem);
        line-height: .95;
        margin: 0 auto clamp(1rem, 2vw, 1.25rem);
        max-width: 12ch;
        text-wrap: balance;
      }

      p {
        width: min(100%, 680px);
        margin: 0 auto;
        font-size: clamp(1rem, 2.5vw, 1.35rem);
        line-height: 1.5;
        opacity: .9;
      }

      .buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
        gap: clamp(.75rem, 2vw, 1rem);
        width: min(100%, 760px);
        justify-content: center;
        margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
      }

      a.button {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: clamp(.85rem, 2vw, 1rem) clamp(1rem, 4vw, 2rem);
        border-radius: 12px;
        text-decoration: none;
        background: #f59e0b;
        color: black;
        font-weight: bold;
        transition: .2s ease;
        width: 100%;
      }

      a.button:hover {
        transform: translateY(-2px);
      }

      @media (max-width: 520px) {
        .hero {
          align-items: flex-start;
          padding-top: 12vh;
          background-position: center top;
        }

        h1 {
          max-width: 10ch;
        }

        .buttons {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <section class="hero">
      <div class="container">
        <img
          class="logo"
          src="https://dedisystems.b-cdn.net/azsrp/Arizona%20State%20Roleplay%20logo-01.png"
          alt="ASRP Logo"
        />

        <h1>Arizona State Roleplay</h1>
        <p>Professional FiveM roleplay experience for Arizona communities.</p>

        <div class="buttons">
          {resources.map((resource) => (
            <a class="button" href={resource.url} target="_blank" rel="noreferrer">
              {resource.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  </body>
</html>
