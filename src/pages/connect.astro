---
const redirectUrl = "fivem://connect/play.arizonastateroleplay.com";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="refresh"
      content={`0;url=${redirectUrl}`}
    />
    <title>Connecting to Arizona State Roleplay...</title>

    <script>
      window.location.replace("fivem://connect/play.arizonastateroleplay.com");
    </script>
  </head>

  <body>
    <p>
      Redirecting to Arizona State Roleplay...
    </p>

    <p>
      If nothing happens,
      <a href="fivem://connect/play.arizonastateroleplay.com">
        click here
      </a>.
    </p>
  </body>
</html>